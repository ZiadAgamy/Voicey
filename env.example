# Copy this file to `.env` and fill it in. NEVER commit your real `.env`.

# Required. Your bot token from the Fluxer developer portal.
FLUXER_BOT_TOKEN=

# Default prefix for new servers. Server admins can change it with `!prefix`.
BOT_PREFIX=!

# Optional. Support server invite shown in the welcome message.
SUPPORT_SERVER_URL=

# Optional. Webhook URL: Voicey will post its logs/warnings/errors there.
# Treat this like a password - anyone with the URL can post to that channel.
VOICEY_LOG_WEBHOOK_URL=

# Optional. Custom emoji ID shown next to the bot's status text.
VOICEY_STATUS_EMOJI_ID=

# Optional. Embed thumbnails. Use direct, PERMANENT image URLs.
# (Fluxer/Discord CDN attachment links expire, so don't use those.)
VOICEY_IMAGE_WELCOME=
VOICEY_IMAGE_CONTROL=
VOICEY_IMAGE_SETUP=
VOICEY_IMAGE_HELP=
VOICEY_IMAGE_PREFIX=
VOICEY_IMAGE_BOTINFO=
VOICEY_IMAGE_UPTIME=
VOICEY_IMAGE_LANGUAGE=

# Optional. Custom emoji IDs (leave blank to use the built-in Unicode emoji).
# See src/config/emojis.js for the full list of EMOJI_*_ID names.
EMOJI_SUCCESS_ID=
EMOJI_ERROR_ID=

# ---------------------------------------------------------------------------
# Web dashboard (optional)
# ---------------------------------------------------------------------------
# Set to true to start the dashboard inside the bot process.
DASHBOARD_ENABLED=false
# Port the dashboard listens on (hosts like Railway/Render set PORT for you).
DASHBOARD_PORT=3000
# Public URL of the dashboard, no trailing slash. The OAuth2 redirect URI you
# register in the Fluxer developer portal must be: <DASHBOARD_URL>/auth/callback
DASHBOARD_URL=http://localhost:3000
# OAuth2 application credentials (same application as the bot).
FLUXER_CLIENT_ID=
FLUXER_CLIENT_SECRET=
FLUXER_API_BASE=https://fluxer.com/api
FLUXER_OAUTH_AUTHORIZE_URL=https://fluxer.com/api/v1/oauth2/authorize
FLUXER_OAUTH_TOKEN_URL=https://fluxer.com/api/v1/oauth2/token
